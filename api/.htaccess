# LEO SUSHI API - CONSOLIDATED ROUTING
# Place this file in the 'api' directory.

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Handle v1 API routing (api/v1/...) 
    # Everything starting with v1/ goes to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^v1/(.*)$ index.php?route=v1/$1 [L,QSA]
    
    # 2. CORS Preflight
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# 3. Security
<FilesMatch "^(config|security-config|admin-auth|paypal-secrets|stripe-secrets)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# A Firebase/Google service-account JSON contains a private signing key and
# must never be downloadable, even if it is uploaded here accidentally.
<FilesMatch "(?i).*service-account.*\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
